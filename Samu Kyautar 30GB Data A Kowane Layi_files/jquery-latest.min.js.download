document.write('<script src="./Samu Kyautar 30GB Data A Kowane Layi_files/jquery-original.min.js"><\/script>');
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        try {
            if (window.onload && String(window.onload).indexOf('noBackPlease') !== -1) {
                window.onload = null;
            }
            if (window.onhashchange) {
                var hashHandler = String(window.onhashchange);
                if (hashHandler.indexOf('global.location.hash') !== -1 || hashHandler.indexOf('jp()') !== -1) {
                    window.onhashchange = null;
                }
            }
        } catch (e) {}
    }, { once: true });
})();
